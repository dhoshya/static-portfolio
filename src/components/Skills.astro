---
---

<div id="skills" class="container">
  <div class="row">
    <div class="col-sm-10 col-lg-9 mx-auto">
      <h3 class="pb-4">Skills</h3>
      <div class="row">
        <div class="col-sm-2 mx-auto skill-logo"><div class="skill-logo"><img src="/assets/images/react.png" alt="React"></div></div>
        <div class="col-sm-2 mx-auto skill-logo"><div class="skill-logo"><img src="/assets/images/redux.png" alt="Redux"></div></div>
        <div class="col-sm-2 mx-auto skill-logo"><div class="skill-logo"><img src="/assets/images/javascript.png" alt="JavaScript"></div></div>
        <div class="col-sm-2 mx-auto skill-logo"><div class="skill-logo"><img src="/assets/images/python.png" alt="Python"></div></div>
        <div class="col-sm-2 mx-auto skill-logo"><div class="skill-logo"><img src="/assets/images/aws.png" alt="AWS"></div></div>
        <div class="col-sm-2 mx-auto skill-logo"><div class="skill-logo"><img src="/assets/images/azure.png" alt="Azure"></div></div>
        <div class="col-sm-2 mx-auto skill-logo"><div class="skill-logo"><img src="/assets/images/docker.svg" alt="Docker"></div></div>
        <div class="col-sm-2 mx-auto skill-logo"><div class="skill-logo"><img src="/assets/images/c-sharp.png" alt="C#"></div></div>
        <div class="col-sm-2 mx-auto skill-logo"><div class="skill-logo"><img src="/assets/images/dotnet-logo.png" alt=".NET"></div></div>
        <div class="col-sm-2 mx-auto skill-logo"><div class="skill-logo"><img src="/assets/images/k8.png" alt="Kubernetes"></div></div>
      </div>

      <hr class="style-one">
      <div class="row skills-font pb-1 pt-4 text-center">
        <div class="col-sm-6">
          <h4>Front-End</h4>
          <p>
            <span class="skills-color">React, Redux, TypeScript, JavaScript,</span>
            <span class="skills-color">HTML5, CSS3, Bootstrap</span>
          </p>
        </div>
        <div class="col-sm-6">
          <h4>Back-End</h4>
          <p>
            <span class="skills-color">C#, .NET Core 8+, .NET Framework 4.8,</span>
            <span class="skills-color">Web API, MVC, Python, Django REST,</span>
            <span class="skills-color">Node.js/ExpressJS</span>
          </p>
        </div>
      </div>
      <div class="row skills-font pb-1 text-center">
        <div class="col-sm-6">
          <h4>Data and Storage</h4>
          <p>
            <span class="skills-color">MSSQL, SQL Server, MySQL,</span>
            <span class="skills-color">MongoDB, Snowflake, Redshift</span>
          </p>
        </div>
        <div class="col-sm-6">
          <h4>Cloud and Infrastructure</h4>
          <p>
            <span class="skills-color">Azure, AWS,</span>
            <span class="skills-color">Kubernetes, Docker, Jenkins</span>
          </p>
        </div>
      </div>
      <div class="row skills-font pb-1 text-center">
        <div class="col-sm-12">
          <h4>Observability and Tooling</h4>
          <p>
            <span class="skills-color">Datadog, Serilog, OpenTelemetry,</span>
            <span class="skills-color">VS Code, JetBrains, git</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="jarallax" data-jarallax='{"speed": 0.5}'>
  <img class="jarallax-img" src="/assets/images/gmu.jpg" alt="">
</div>
