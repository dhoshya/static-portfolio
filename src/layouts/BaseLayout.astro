---
interface Props {
  title?: string;
  description?: string;
}
const { title = "Rohan Joshi", description = "Software Engineer Portfolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" id="scrollbar">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content={description}>
<meta name="author" content="Rohan Vijay Joshi">
<title>{title}</title>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous">
<link rel="stylesheet" href="/assets/styles/font-awesome.min.css">
<link rel="stylesheet" href="/assets/styles/main.css">
<link rel="stylesheet" href="/assets/styles/scrollbar.css">
<link rel="stylesheet" href="/assets/styles/navbar.css">
<link rel="stylesheet" href="/assets/styles/animate.css">
<link rel="stylesheet" href="/assets/styles/skills.css">
<link rel="stylesheet" href="/assets/styles/experience.css">
<link rel="stylesheet" href="/assets/styles/footer.css">
<link rel="stylesheet" href="/assets/styles/projects.css">
<link rel="stylesheet" href="/assets/styles/projectButtons.css">
</head>
<body data-spy="scroll" data-target="#nav-spy">

<div id="particles-js"></div>

<slot />

<script is:inline src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct" crossorigin="anonymous"></script>
<script is:inline src="/assets/scripts/particles.js"></script>
<script is:inline src="/assets/scripts/jarallax.js"></script>
<script is:inline src="/assets/scripts/particles-loader.js"></script>
<script is:inline src="/assets/scripts/experience.js"></script>
<script is:inline src="/assets/scripts/navigate.js"></script>
<script is:inline src="/assets/scripts/textScrambler.js"></script>
<script data-goatcounter="https://dhoshya.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>
</body>
</html>
